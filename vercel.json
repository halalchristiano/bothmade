{
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/stale-leads",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/cron/follow-up-digest",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/payment-clock",
      "schedule": "0 9 * * *"
    }
  ]
}
