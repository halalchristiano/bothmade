// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User accounts (Bothmade team members)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypted
  name      String?
  role      String   @default("admin") // "owner" (Kiana — PM/ops), "sales" (Evan — CRM/closing), "admin" (generic)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every session minted before this instant is refused. Sessions are 7-day
  // JWTs with no server-side store, so without this a password change did
  // nothing to a token already stolen — the thief kept access for the rest of
  // the week. Set on password change and password reset; null means nothing
  // has ever been revoked for this account.
  sessionsValidFrom DateTime?

  // Gmail "send as" connection — lets client emails go out from the user's
  // own Gmail address (and land in their real Sent folder) instead of a
  // shared no-reply address. gmailAppPassword is encrypted at rest.
  // App Passwords don't exist for most Google Workspace accounts (Google
  // requires "less secure app" access that Workspace admins can no longer
  // enable), so googleRefreshToken (OAuth 2.0, "Sign in with Google") is
  // the path that actually works for a @bothmade.studio address — tried
  // first in sendAsUser(), with the app password kept only as a fallback
  // for personal Gmail accounts that still support it.
  gmailAddress       String?
  gmailAppPassword   String?
  gmailConnectedAt   DateTime?
  googleRefreshToken String? // encrypted at rest, same as gmailAppPassword

  // Set when a Gmail read fails for want of a scope — a token minted before
  // reading was needed can still send, so nothing looks broken while bounce
  // and reply detection sit silently dead. Cleared on a successful reconnect.
  gmailNeedsReconnect Boolean @default(false)

  // Headshot shown in the outbound-email footer next to the sender's name.
  avatarUrl String?

  // Job title shown in email sign-offs — pre-fills the "Your title" field
  // on cold-outreach/custom templates instead of retyping it every send.
  title String?

  // When true (default), bulk cold-email sends show a preview of every
  // recipient's subject/body before anything actually goes out.
  previewBeforeBulkSend Boolean @default(true)

  // Opts out of the Friday weekly-digest email (everyone gets it by default).
  weeklyDigestOptOut Boolean @default(false)

  // When this user last opened the team chat. A single per-user timestamp
  // works because the chat is one flat thread, and unlike TeamMessage.readAt
  // it can represent per-user read state for broadcast messages
  // (toUserId = null), which a shared readAt could not — a broadcast marked
  // read by one person was read for everybody.
  teamChatReadAt DateTime?

  // Relations
  clientMessages       ProjectMessage[] @relation("SentByUser")
  adminUpdates         ProjectUpdate[]  @relation("CreatedByAdmin")
  assignedLeads        Lead[]           @relation("AssignedLeads")
  leadActivities       LeadActivity[]   @relation("LeadActivityAuthor")
  teamNotes            TeamNote[]       @relation("TeamNoteAuthor")
  tasks                Task[]           @relation("TaskAssignee")
  createdTasks         Task[]           @relation("TaskCreator")
  sentTeamMessages     TeamMessage[]    @relation("TeamMessageSender")
  receivedTeamMessages TeamMessage[]    @relation("TeamMessageRecipient")
  csvImportLogs        CsvImportLog[]
  uploadedMockups      LeadMockup[]     @relation("MockupUploader")
  issuedInvoices       Invoice[]        @relation("InvoiceIssuer")
  recurringOffers      RecurringOffer[] @relation("RecurringOfferAuthor")

  @@map("users")
}

// Clients who have signed up via Stripe
model Client {
  id          String  @id @default(cuid())
  email       String  @unique
  password    String // bcrypted - auto-generated on first signup
  company     String
  phone       String?
  contactName String?

  // Stripe integration
  stripeCustomerId String?
  subscription     String? // "starter", "pro", "enterprise"
  subscriptionTier Int     @default(1) // 1 = Starter ($2500), 2 = Pro ($5000), 3 = Enterprise (custom)

  // Status
  onboardingComplete Boolean   @default(false)
  mustChangePassword Boolean   @default(true) // forces a password reset on first login after being auto-generated
  lastLoginAt        DateTime?
  archivedAt         DateTime? // "decommissioned" — hidden from active lists, login blocked, but records kept intact
  // See User.sessionsValidFrom — same contract. It matters more here: the
  // first password a client holds was auto-generated and emailed to them in
  // plaintext, so the change away from it is exactly when old sessions
  // should stop working.
  sessionsValidFrom  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  projects         Project[]
  messages         ProjectMessage[]  @relation("SentByClient")
  emailPreferences EmailPreferences?
  invoices         Invoice[]

  @@map("clients")
}

// Projects (deliverables for clients)
model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      String  @default("discovery") // "discovery", "design", "build", "launch", "complete"
  statusStage Int     @default(0) // 0-4 corresponding to status above

  // Project details
  baseService String // "website", "web-app", "ios-app", "macos-app", "visionos", "multi"
  addOns      String @default("") // comma-separated: "seo", "analytics", "maintenance", "hosting"
  // Ad-hoc items added on the lead's proposal beyond the fixed catalogue,
  // carried over so onboarding shows the full scope the client paid for.
  // [{ label: string, priceCents: int }]
  customItems Json   @default("[]")

  // Timeline & pricing
  timeline   String? // "4 weeks", "8 weeks", "12 weeks", etc.
  basePrice  Int // in cents
  totalPrice Int // in cents (including add-ons)

  // Rough target date for the current stage, shown to the client for
  // reassurance — set manually by the team, not derived/computed.
  estimatedCompletionDate DateTime?

  // The actual deployed/shipped product — set once, when there's finally
  // something real to point at. Powers the "your project is live" delivery
  // moment on the client dashboard once status reaches Complete.
  liveUrl String?

  // Deliverables
  deliverables String? // JSON array of milestone/deliverable objects

  // Stripe checkout session that created this project (idempotency + audit)
  stripeSessionId String? @unique

  // Sales handoff tracking — links back to the Lead this was converted from
  // (when it came through the sales CRM rather than a direct client signup),
  // and when ops acknowledged picking up a freshly-converted project.
  convertedFromLeadId   String?
  handoffAcknowledgedAt DateTime?

  // Copy of the exact contract the client agreed to before paying (or the
  // last one generated, for manually-onboarded projects) — carried over
  // from the Lead so the client can always find it in their own dashboard.
  contractUrl String?

  // When a payment reminder was last emailed for this project's balance —
  // shown on the dashboard so a reminder can't be fired off twice in a row
  // by accident after a page reload forgets the button was already used.
  lastPaymentReminderSentAt DateTime?

  // Capability token for the public, no-login status page (/status/[id]?t=…).
  // Separate from the cuid PK on purpose: knowing a project's ID — which
  // shows up in admin URLs, emails, and Stripe metadata — must not be the
  // same thing as being allowed to read its status. Rotate to revoke a link.
  shareToken String @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))"))

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages            ProjectMessage[]
  updates             ProjectUpdate[]
  teamNotes           TeamNote[]
  onboardingQuestions OnboardingQuestion[]
  payments            Payment[]
  instalments Instalment[]
  invoices            Invoice[]
  recurringOffers     RecurringOffer[]

  @@map("projects")
}

// Messages between client and team in project thread
model ProjectMessage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Message content
  content     String
  isFromAdmin Boolean @default(false) // true if from User (admin), false if from Client

  // Sender info
  userId String?
  user   User?   @relation("SentByUser", fields: [userId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation("SentByClient", fields: [clientId], references: [id], onDelete: SetNull)

  // File attachments (URLs)
  attachments String @default("") // JSON array of { name, url }

  createdAt DateTime @default(now())

  @@map("project_messages")
}

// Project status updates (visible to client in dashboard)
model ProjectUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String
  statusStage String // "discovery", "design", "build", "launch"

  // Who created this update (null for system-generated updates, e.g. post-checkout)
  userId String?
  user   User?   @relation("CreatedByAdmin", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("project_updates")
}

// Email notification preferences
model EmailPreferences {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  notificationsEnabled Boolean @default(true)
  digestFrequency      String  @default("daily") // "immediate", "daily", "weekly"
  statusUpdates        Boolean @default(true)
  messages             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_preferences")
}

// Sales CRM: prospective clients Evan (or anyone on the team) is working
model Lead {
  id             String  @id @default(cuid())
  company        String
  contactName    String?
  email          String?
  phone          String?
  status         String  @default("new") // "new", "contacted", "qualified", "proposal", "won", "lost"
  source         String? // "referral", "cold-outreach", "inbound", etc.
  estimatedValue Int? // cents
  painPoints     String  @default("") // comma-separated tags, e.g. "no-mobile-app,slow-site"
  notes          String? // freeform quick notes, separate from the activity timeline

  hotLead        Boolean   @default(false) // flagged by sales as a priority deal
  lostReason     String? // freeform reason captured when status is set to "lost"
  nextFollowUpAt DateTime? // self-set reminder date for the next touch
  contractStatus String    @default("not_sent") // "not_sent", "sent", "signed"

  // --- Who this business actually is -------------------------------------
  // Industry and address used to be appended to `notes` as prose, which made
  // them unfilterable and unsortable — you could read "Industry: Dental
  // practice" but never ask for every dental practice. They're columns now.
  industry    String?
  contactRole String? // job title — the fastest read on whether they can sign
  altPhone    String?
  address     String?
  city        String?
  region      String? // state / county / province
  postalCode  String?
  country     String?
  timezone    String? // IANA name; falls back to the area-code guess when absent

  // --- How big they are ---------------------------------------------------
  // These exist to size a quote. A point with no catalogue price gets a
  // suggested one scaled from whichever of these is on file, so the number
  // beside a bespoke line item is at least anchored to the business rather
  // than invented. See lib/lead-pricing.ts.
  companySize        String? // "solo" | "small" | "medium" | "large" | "enterprise"
  employeeCount      Int?
  locationCount      Int?
  annualRevenueCents Int?
  yearFounded        Int?

  // --- Public presence, i.e. the raw material for a personalised opener ---
  googleRating      Float?
  googleReviewCount Int?
  googleMapsUrl     String?
  instagramUrl      String?
  facebookUrl       String?
  linkedinUrl       String?

  // Freeform comma-separated labels ("franchise,referral-partner,q3-push").
  // Deliberately not an enum — the useful ones are never known in advance.
  tags String @default("")

  // A hard stop, not a preference. Set when someone asks not to be contacted;
  // every outreach path checks it before sending or dialling.
  doNotContact       Boolean @default(false)
  doNotContactReason String?

  // 0-100, set by research at import time. Ordering hint only — it never
  // gates anything, so a bad score can't quietly bury a real opportunity.
  leadScore Int?

  mockupRequested   Boolean   @default(false) // Evan asking Kiana to put together a mockup for this lead
  mockupRequestedAt DateTime?
  // The most recent mockup, mirrored from the `mockups` list below so the
  // "is this lead still waiting on design" queries and the email templates'
  // default link stay one column lookup rather than a join. The list is the
  // record; these two are a cache of its newest entry.
  mockupUrl         String?
  mockupDeliveredAt DateTime?

  // A PDF export of the mockup is another version of it, not a different
  // kind of thing, so it lives in the `mockups` list with a fileName set
  // rather than in a column of its own. The link is the better thing to
  // show on a call; the PDF is what survives — no signal, no password, and
  // still openable in a year once the preview deployment is gone.

  // Mockups deploy behind Vercel's password protection so a prospect's
  // competitors (and Google) can't find their unannounced redesign. Kept
  // per-lead because each deployment gets its own.
  vercelDeployPassword String?

  // The signed invoice for this deal, once there is one. Empty until the
  // lead is actually onboarded — from then on it's the copy Evan can pull
  // up or hand over without going back through email.
  invoicePdfUrl        String?
  invoicePdfUploadedAt DateTime?

  // A fully pre-written cold email (subject on the first line as "Subject: ...",
  // body after), usually populated via CSV import from research done ahead of
  // outreach — lets a lead be cold-emailed in one click with zero typing,
  // instead of routing through the template composer every time.
  coldEmailDraft  String?
  coldEmailSentAt DateTime?

  // Set when a send attempt to this lead's email actually fails (bounced,
  // rejected, dead address) — distinct from simply never having sent one.
  // Surfaced as its own "couldn't reach — call instead" list so a bad
  // address doesn't just quietly vanish from the ready-to-send count.
  // Cleared automatically the next time a send to this lead succeeds.
  emailDeliveryFailedAt     DateTime?
  emailDeliveryFailedReason String?

  // The phone equivalent: set when a call reaches a dead or wrong number.
  // A flagged lead drops out of the callable band instead of being re-dialed,
  // but still shows under "can't reach" so it can be given a new number
  // rather than silently disappearing.
  phoneInvalidAt DateTime?

  // A short one-liner (not the full draft above) usable as the "personalized
  // observation" field the cold-outreach templates require — lets Compose
  // Email pre-fill that field from research done at CSV-import time instead
  // of starting blank every time.
  personalizedObservation String?

  // Their existing site, if they have one — a dedicated field (rather than
  // folded into notes) so it can be a one-click link on the lead detail
  // page instead of buried in a paragraph of text.
  originalWebsite String?

  // A short strategic note for whoever's working this lead — "lead with the
  // booking system, they mentioned losing appointments to no-shows" — as
  // opposed to `notes`, which is general freeform info about the business.
  salesNote String?

  // Hand-written, per-lead sales content from the research CSV. Each holds
  // one "Point: explanation written about this specific business" per line.
  // Stored as text rather than 25 separate columns because the count varies
  // per lead and nothing ever queries an individual point — they're only
  // ever read back as an ordered list on the lead's page. When present these
  // take precedence over the generic pain-point heuristics, since a human
  // who looked at the business beats a lookup table every time.
  // A written assessment of the site they have today ("Underperforming
  // local-service website: still shows template remnants..."), shown right
  // beside the link to it so the rep reads the verdict and the site together.
  // When someone at this business last wrote back. A reply is the strongest
  // buying signal there is, and without recording it the lead just kept
  // sinking down a queue ordered by neglect.
  replyReceivedAt DateTime?

  currentSiteAssessment String? @db.Text

  customPainPoints String? @db.Text
  essentialPoints  String? @db.Text
  upsellPoints     String? @db.Text

  // The quotable range for this lead, in cents. Low = core essentials only,
  // high = everything including upsells.
  estimateLowCents  Int?
  estimateHighCents Int?

  // BANT-style qualification — structured so "qualified" means something
  // consistent instead of a gut call. Each is a freeform answer summary,
  // not just a checkbox, since the real value is in what was actually said.
  qualNeed       String? // does the current situation create an actual problem?
  qualAuthority  String? // can this person actually approve the project?
  qualBudget     String? // realistic expectations vs. our $5-6k range?
  qualTiming     String? // is there a real driver/timeline, or "someday"?
  qualMotivation String? // why are they considering this now?
  qualifiedAt    DateTime? // set automatically once all 5 fields are filled

  // The proposal Evan prepared, persisted so the public sign-and-pay page
  // can reconstruct the exact same pricing/contract without re-entering it.
  proposalBaseService String?
  proposalAddOns      String  @default("") // comma-separated
  proposalClientType  String?
  proposalTimeline    String?
  proposalTotalPrice  Int? // cents, overrides the computed total if set
  proposalDepositOnly Boolean @default(false)

  // True where the person signing is an individual acting outside a
  // business. Routes the consumer form of the agreement — statutory 14-day
  // cancellation, pro-rata charging — instead of the B2B form. A checkbox on
  // the proposal, because by the time anyone is reading the contract it is
  // too late for the contract to change shape.
  isConsumer Boolean @default(false)
  // Ad-hoc items Evan adds beyond the fixed catalogue — a name and a price he
  // sets himself. Stored as-is (not looked up against ADD_ONS) since these
  // don't correspond to any catalogue key. [{ label: string, priceCents: int }]
  proposalCustomItems Json    @default("[]")

  // Clickwrap agreement captured at the moment the client agrees to the
  // contract on the sign-and-pay page, right before checkout. Between them
  // these answer the four questions anyone disputing a clickwrap asks: who
  // agreed, to what, when, and from where.
  agreementSignedAt DateTime?
  agreementIp       String?
  agreementHash     String? // sha256 of the exact contract text + statement shown at signing
  signedContractUrl String? // saved PDF copy of what they actually agreed to
  // The name the client typed to sign. The checkbox alone is a click; a
  // typed name is the affirmative act, and it's the only part of the record
  // that says who was at the keyboard rather than which link was opened.
  agreementSignerName String?
  // Browser and device the signature came from, alongside the IP. Two weak
  // identifiers that agree are worth more than either on its own.
  agreementUserAgent  String?
  // The exact sentence they ticked, stored rather than assumed, so a later
  // reword of the consent copy can't retroactively change what an existing
  // signature claims the client accepted.
  agreementStatement  String?

  // Capability token for the public sign-and-pay page (/sign/[id]?t=…).
  // The link is both "read the proposal" and "agree to the contract", so it
  // gets its own unguessable secret rather than reusing the cuid PK, which
  // is visible in admin URLs, Stripe metadata, and activity records.
  shareToken String @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))"))

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  // When this business entered the pipeline, as opposed to when the row was
  // written. They're the same for a lead added by hand and different for one
  // imported from a sheet that was researched three weeks ago — which is why
  // this is separate from createdAt rather than overwriting it. Reporting
  // ("how many did we add between these two dates") reads this one; createdAt
  // stays an untouched audit fact.
  addedAt DateTime @default(now())

  // The day they stopped being a lead and became a client. Set automatically
  // when the lead is marked won or converts into a project, and importable
  // so historical clients arrive with the real date rather than today's.
  clientTakenOnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  mockups    LeadMockup[]

  // Every list in the admin either filters by owner and stage, sorts by when
  // a lead arrived, or looks one up by name/email — so those are the reads
  // worth an index once the table is thousands of rows rather than hundreds.
  @@index([addedAt])
  @@index([status, addedAt])
  @@index([assignedToId, status])
  @@index([clientTakenOnAt])
  @@index([email])
  @@index([company])
  @@map("leads")
}

// Every mockup that has been put in front of one lead, oldest first.
//
// A deal rarely gets one mockup: the first version goes out, the business
// asks for the menu on the homepage, a second version follows. A single
// `mockupUrl` column meant version two overwrote version one, so the rep on
// the call had no way to open "the one I sent you last Tuesday" — and no
// place to record what the client said about it. Each row is one version,
// with the note the rep took against that specific version.
model LeadMockup {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  url      String // a link (Figma, Loom, staging site) or an uploaded file's URL
  fileName String? // set only when the mockup was uploaded rather than linked

  // The rep's own notes on this version — what was shown, what came back,
  // what to change next time. Per-version rather than per-lead, because
  // "they hated the hero" is only true of the mockup it was said about.
  note String @default("") @db.Text

  uploadedById String?
  uploadedBy   User?   @relation("MockupUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@map("lead_mockups")
}

// A permanent receipt of every CSV lead import — who ran it, what file,
// how many rows landed vs. got skipped. Exists so "did I already import
// this batch" and "who imported these 800 leads" have an actual answer
// instead of relying on memory or reverse-engineering it from lead
// createdAt timestamps.
model CsvImportLog {
  id            String   @id @default(cuid())
  fileName      String?
  rowCount      Int
  importedCount Int
  skippedCount  Int
  importedById  String?
  importedBy    User?    @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@map("csv_import_logs")
}

// Timeline of outreach on a lead: notes, logged emails, calls, Loom links
// The answer sheet behind every line item a rep might have to defend on a
// call: what it is in plain English, what it costs, the words to sell it,
// and why that price is fair.
//
// Research CSVs name the work ("Guided selection system") and explain why
// this business needs it, but never what to charge or how to justify it.
// Deriving that at render time meant a rep could hit an item with no answer
// mid-call, so it lives in the database instead — seeded, editable, and the
// same for every lead that mentions the item.
//
// Matched to a written point by `slug`, which is the item's name reduced to
// letters and digits only.
model SalesPlaybookItem {
  id            String  @id @default(cuid())
  slug          String  @unique
  label         String
  kind          String  @default("essential") // "essential" | "upsell"
  priceCents    Int
  whatItIs      String  @db.Text // plain English — assumes no technical background
  benefit       String  @default("") @db.Text // how THIS business gains; {company} is substituted at render time
  pitch         String  @db.Text // said to the customer, close to verbatim
  justification String  @db.Text // why the price is fair, in business terms
  objection     String? @db.Text // the pushback this attracts, and the answer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales_playbook_items")
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type    String // "note", "email", "call", "loom"
  content String
  url     String? // Loom link, or reference URL

  createdById String?
  createdBy   User?   @relation("LeadActivityAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("lead_activities")
}

// Internal notes on a project — visible to the Bothmade team only, never the client
model TeamNote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  content String

  authorId String?
  author   User?   @relation("TeamNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("team_notes")
}

// Custom onboarding questions an admin defines per-project, for the client to fill out
model OnboardingQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  question String
  type     String @default("text") // "text", "textarea", "select"
  options  String @default("") // comma-separated, only used when type = "select"
  order    Int    @default(0)

  createdAt DateTime @default(now())

  response OnboardingResponse?

  @@map("onboarding_questions")
}

// A single Stripe payment against a project — a project's total price may be
// collected as one full payment, or split into a deposit followed by a
// balance payment. Amount paid so far = sum of these rows.
// One scheduled slice of a project's contracted price, labelled the way the
// client reads it: "Payment 1 of 3". The schedule is seeded in full when the
// project is created — 50/25/25 under $20k, 40/30/30 at and above — so the
// dashboard, the invoices, and the contract are all reading the same three
// rows rather than each recomputing a schedule that might have changed
// since. Money stays on Payment; these rows are the *plan*, and paidAt is
// the reconciliation mark the webhook sets when Stripe confirms.
model Instalment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  index       Int // 1-based, so label and index never disagree
  count       Int
  label       String // "Payment 1 of 3" — the exact phrase on the invoice and email
  percent     Int
  amountCents Int
  trigger     String // "signing", "design-approval", "ready-for-launch"

  // "scheduled" — gate not reached, nothing owed. "due" — invoiced, payable.
  // "paid" — settled. "void" — cancelled schedule (project ended early).
  status String @default("scheduled")

  // Set when the instalment is invoiced: the sequential BM- number ties the
  // instalment to the invoice ledger, and paymentUrl is the live Stripe
  // checkout for it.
  invoiceNumber   String?   @unique
  stripeSessionId String?   @unique
  paymentUrl      String?
  invoicedAt      DateTime?
  dueAt           DateTime?
  emailSentAt     DateTime?
  paidAt          DateTime?

  createdAt DateTime @default(now())

  @@unique([projectId, index])
  @@index([projectId])
  @@map("instalments")
}

model Payment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount Int // cents
  type   String // "deposit", "balance", "full", "custom"

  stripeSessionId String? @unique

  // Set when this payment settled a one-off custom charge rather than the
  // project's contracted price. Those two must not be added together: a
  // "custom" payment is money for work priced outside Project.totalPrice, so
  // counting it against the balance would quietly mark a project paid off
  // because someone was billed separately for a change request. See
  // amountPaidTowardProject() in lib/billing.ts — every balance calculation
  // goes through it.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("payments")
}

// A one-off charge raised against an existing customer for an amount someone
// on the team typed in — a change request, an extra round of design, a month
// of retainer work. Everything else in this schema prices itself from the
// catalogue; this is the escape hatch for work that never fit it.
//
// The row is the record. The PDF is generated and stored the moment the
// charge is raised (not on demand later) so the invoice a client is looking
// at and the invoice in our books are the same file, and it is kept whether
// or not the charge is ever paid — an issued invoice that vanished because
// nobody paid it is not a record.
model Invoice {
  id String @id @default(cuid())

  // Human-facing, sequential within the year: "BM-2026-0007". Unique, because
  // two invoices sharing a number is the one accounting error nobody can
  // untangle afterwards.
  number String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Which project this hangs off. Required: the client's dashboard is
  // per-project, so an invoice with no project is an invoice the client has
  // nowhere to see.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // What the charge is for, in the words that go on the invoice and in the
  // email subject.
  description String

  // [{ label, priceCents }] — the same shape as Project.customItems, so the
  // PDF builder takes either without translation.
  lineItems Json @default("[]")

  amountCents Int
  currency    String @default("usd")

  // "open" — issued, unpaid. "paid" — settled via Stripe (or marked by hand).
  // "void" — cancelled; kept, never deleted.
  status String @default("open")

  // The stored PDF and the Stripe link that pays it. Both nullable: a failure
  // to render or to reach Stripe must not lose the charge itself, and the
  // invoice stays visible with whichever half succeeded.
  pdfUrl              String?
  paymentUrl          String?
  stripePaymentLinkId String?

  // Who raised it, and where the client's copy went.
  issuedById  String?
  issuedBy    User?   @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  sentToEmail String?

  paidAt    DateTime?
  voidedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments Payment[]

  @@index([clientId])
  @@index([projectId])
  @@map("invoices")
}

// An offer to put a client onto one of the recurring "ongoing care" services
// — hosting, maintenance, a growth plan — either because they took it in the
// original scope and the prepaid months are running out, or as an upsell at
// the end of a build for someone who didn't.
//
// Deliberately NOT a Payment row per month. Payment is what the project's
// balance is derived from (`totalPrice - sum(payments)`), so booking a
// recurring charge there would show a project as overpaid every month
// forever. Subscription money is its own ledger — see RecurringPayment.
model RecurringOffer {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Comma-separated add-on keys, all from the catalogue's "ongoing-care"
  // category (see lib/recurring.ts).
  addOns String

  // The standard rate the plan reverts to once the introductory year is up.
  // Copied off the catalogue at send time rather than recomputed later, so a
  // future price change can't quietly re-price a plan someone already agreed to.
  monthlyCents Int

  // The introductory discount, chosen per-offer by whoever is selling it.
  // "percent" = percentage points off; "amount" = cents off each month.
  discountType  String @default("percent")
  discountValue Int    @default(0)

  // Months at no charge before billing starts — 2 when the service was in the
  // original scope (first month included in the project price, second month
  // covered as the sign-on sweetener), 0 for a cold upsell.
  freeMonths Int @default(0)

  // How many billed months run at the introductory rate before the standard
  // one resumes. Stored rather than assumed so an already-sold plan keeps its
  // terms if the default ever changes.
  discountMonths Int @default(12)

  // The line the rep wants in the offer email, in their own words.
  note String?

  status String @default("sent") // "sent" | "active" | "declined" | "canceled"

  // Capability token for the no-login offer page (/care/[token]). Same
  // reasoning as Project.shareToken: the ID that appears in admin URLs must
  // not also be the thing that authorizes signing up for a monthly charge.
  token String @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))"))

  sentAt      DateTime  @default(now())
  acceptedAt  DateTime?
  declinedAt  DateTime?
  canceledAt  DateTime?

  stripeCheckoutSessionId String? @unique
  stripeSubscriptionId    String? @unique
  // Kept so the discount that's actually running can be looked up in Stripe
  // when a client asks what they're on.
  stripeCouponId          String?

  createdById String?
  createdBy   User?   @relation("RecurringOfferAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  payments RecurringPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
  @@map("recurring_offers")
}

// One paid monthly invoice against an active care plan. Its own table rather
// than Payment for the reason above, and keyed on the Stripe invoice ID so a
// redelivered webhook can't bill or email the client twice.
model RecurringPayment {
  id      String         @id @default(cuid())
  offerId String
  offer   RecurringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  amount Int // cents actually charged, after the discount
  // What the same month would have cost at the standard rate — kept so the
  // invoice can show the saving rather than just a smaller number.
  standardAmount Int

  stripeInvoiceId  String  @unique
  invoiceNumber    String?
  hostedInvoiceUrl String?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
  @@map("recurring_payments")
}

// A personal to-do — assignable to any team member, optionally linked to a
// lead or project so it shows up in context, but also usable standalone.
model Task {
  id    String    @id @default(cuid())
  title String
  done  Boolean   @default(false)
  dueAt DateTime?

  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  relatedLeadId    String?
  relatedProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

// Direct internal messaging between team members (Kiana <-> Evan), separate
// from lead-specific activity notes — a private "loop me in" channel not
// tied to any one deal, optionally referencing a lead or project for context.
model TeamMessage {
  id      String @id @default(cuid())
  content String

  fromUserId String
  fromUser   User   @relation("TeamMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String? // null = visible to all team members (broadcast)
  toUser   User?   @relation("TeamMessageRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  relatedLeadId    String?
  relatedProjectId String?

  urgent   Boolean @default(false) // a flagged question needing action, not just a casual chat message
  resolved Boolean @default(false)

  // "chat" is a person talking; "system" is the app narrating (a payment
  // landing, a mockup delivered). They shared one undifferentiated shape,
  // which meant the Stripe webhook's celebration bubble rendered as words
  // some real person never wrote. System rows keep a fromUserId (the
  // schema requires an author and cascade anchor) but render as timeline
  // rows, not speech.
  kind String @default("chat")

  // [{ name, url }] — files shared in the thread, stored on Blob like every
  // other upload. Native Json, matching the newer columns, not the legacy
  // JSON-in-string pattern.
  attachments Json @default("[]")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // The unread predicate and the notifications bell filter on these every
  // poll for every staff session; the event-bus traffic makes the table
  // grow far faster than a two-person chat suggests.
  @@index([createdAt])
  @@index([toUserId, createdAt])
  @@index([relatedLeadId, urgent, resolved])
  @@map("team_messages")
}

// A pending password-reset link.
//
// These used to live in a module-level Map inside the reset route. On
// serverless that Map belongs to whichever instance happened to serve the
// request, so a link minted on one instance was "invalid or expired" on the
// next, and every outstanding link died silently on redeploy. Worse, the
// Map was never pruned and held plaintext tokens in memory.
//
// Only the SHA-256 of the emailed token is stored, so a database read yields
// no working reset links. Single-use is enforced by `usedAt`.
model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  userType    String // "user" (team member) | "client"
  expiresAt   DateTime
  usedAt      DateTime?
  // Kept for abuse investigation — who asked for the reset, not who used it.
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([email, userType])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// The client's answer to one onboarding question
model OnboardingResponse {
  id         String             @id @default(cuid())
  questionId String             @unique
  question   OnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_responses")
}

// One row per rate-limited caller per endpoint.
//
// Rate limits have to be shared across every serverless instance to mean
// anything — a per-process counter hands an attacker a fresh budget with
// each cold start. This app already has a Postgres connection open on every
// one of these routes, so the limit lives here rather than behind another
// service to provision, pay for, and monitor. Volume is a handful of writes
// per human action, which is noise next to the queries those routes already
// run.
model RateLimit {
  // "rl:<scope>:<caller>", e.g. "rl:admin-login:203.0.113.4"
  key         String   @id
  count       Int      @default(1)
  // Start of the current window. Rolls forward when the window lapses.
  windowStart DateTime @default(now())

  // Lets the opportunistic sweep find lapsed rows without a full scan.
  @@index([windowStart])
  @@map("rate_limits")
}
