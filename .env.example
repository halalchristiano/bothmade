# Copy to .env.local for development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Env var changes don't apply to already-running deployments — redeploy after.

# --- Required ---------------------------------------------------------------

DATABASE_URL="postgresql://user:password@host:5432/bothmade"
DIRECT_URL="postgresql://user:password@host:5432/bothmade"

# The real domain. Until this is set, canonical URLs, Open Graph tags, the
# sitemap, robots and JSON-LD all publish localhost links.
NEXT_PUBLIC_SITE_URL="https://bothmade.studio"

# REQUIRED. The production build fails without these two, deliberately: the
# old fallbacks were strings published in this repository, so a deploy that
# forgot one signed every admin session with a value anyone could read.
# Generate each SEPARATELY — do not reuse one value:  openssl rand -base64 48
JWT_SECRET=""
SESSION_SECRET=""

# Encrypts Gmail app passwords and Google refresh tokens at rest. Its own key
# so it can be rotated independently of SESSION_SECRET. Not needed to build;
# every Gmail-connected feature fails loudly until it is set. Mailboxes
# connected before this existed still decrypt via the old SESSION_SECRET-derived
# key, and reconnecting in Settings re-encrypts them under this one.
GMAIL_ENCRYPTION_KEY=""

# Only for a brand-new deployment with an empty users table: allows ONE owner
# account to be created via POST /api/auth/signup with an x-bootstrap-token
# header. The path closes permanently once any account exists. Leave unset on
# an established deployment — after that only an owner can add teammates.
ADMIN_BOOTSTRAP_TOKEN=""

# Set to 1 to ship the Content-Security-Policy as Report-Only for one deploy
# (violations logged to the browser console, nothing blocked) instead of
# enforcing it. Leave unset to enforce.
CSP_REPORT_ONLY=""

# --- Email ------------------------------------------------------------------

# resend.com → API Keys. Without it the contact form still records the lead,
# but nobody is notified.
RESEND_API_KEY=""

# The address mail is sent FROM. Its domain must be verified in Resend
# (SPF + DKIM) or every send is rejected. Defaults to info@bothmade.studio.
CONTACT_EMAIL="info@bothmade.studio"

# Who inbound enquiries are sent TO — comma-separated. Defaults to
# info@ + evan@ + kiana@ bothmade.studio, so it only needs setting to change
# that list. Note these are notification recipients only: every enquiry lands
# in the CRM under /admin/leads whether or not mail is configured.
STUDIO_INBOX="info@bothmade.studio,evan@bothmade.studio,kiana@bothmade.studio"

# Fallback for the "this client reached out" alert, used only when no user
# account has role "sales". Normally leave this unset: the alert goes to
# whoever holds that role, and the lead is assigned to them so it reaches
# their call list and follow-up digest — which a bare address cannot do.
SALES_EMAIL="evan@bothmade.studio"

# --- Stripe -----------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Vercel cron ------------------------------------------------------------

# Shared secret the scheduled jobs in vercel.json authenticate with.
CRON_SECRET=""

# --- Google (admin "Sign in with Google" — see LAUNCH.md) --------------------

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Service-account alternative to the OAuth flow above.
GOOGLE_SA_CLIENT_EMAIL=""
GOOGLE_SA_PRIVATE_KEY=""

# --- Optional overrides -----------------------------------------------------

# AUTH_COOKIE_NAME=""
# AUTH_COOKIE_MAX_AGE=""
