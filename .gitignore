# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local working files — lead CSVs, import sheets, one-off exports. Untracked
# but not ignored is the dangerous combination: the directory holds real
# names, emails and phone numbers, and it was one `git add -A` away from
# being public on a repository that anyone can read.
/scratchpad

# Screenshots from scripts/screenshots — look at them, don't commit them.
.screenshots/
